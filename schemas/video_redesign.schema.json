{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/partme-ai/partme-dreamina-design/schemas/video_redesign.schema.json",
  "title": "Dreamina Versioned Video Redesign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "parent_version", "project_id", "analysis_version", "source_sha256", "machine_fingerprint", "creative_mode", "rights_receipt_id", "design_fingerprint", "payload", "similarity_audit", "committed_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "version": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "parent_version": {"type": ["string", "null"], "pattern": "^v[0-9]{3,}$"},
    "project_id": {"type": "string", "pattern": "^vp_[a-f0-9]{24}$"},
    "analysis_version": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "machine_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "creative_mode": {"type": "string", "enum": ["authorized_replication", "original_redesign"]},
    "rights_receipt_id": {"type": ["string", "null"], "pattern": "^rr_[a-f0-9]{24}$"},
    "design_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "creative_mode", "machine_fingerprint", "preserve", "required_media", "purpose", "audience", "territory", "format", "target_duration_seconds", "aspect_ratio", "platform", "concept", "cast", "settings", "palette", "visual_style", "dialogue", "narration", "music", "sound_intent", "shots", "continuity", "author"],
      "allOf": [
        {"if": {"properties": {"creative_mode": {"const": "original_redesign"}}}, "then": {"required": ["replacements"]}},
        {"if": {"properties": {"creative_mode": {"const": "authorized_replication"}}}, "then": {"not": {"required": ["replacements"]}}}
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "creative_mode": {"type": "string", "enum": ["authorized_replication", "original_redesign"]},
        "machine_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "preserve": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["timing", "shot_sizes", "camera_moves", "rhythm", "transitions", "audio_beats", "likeness", "voice", "dialogue", "music", "brand", "artwork", "distinctive_props", "effects", "ambience"]}},
        "replacements": {"type": "object", "additionalProperties": false, "required": ["likeness", "voice", "dialogue", "music", "brand", "artwork", "settings", "costume", "distinctive_props"], "properties": {"likeness": {"type": "string", "minLength": 1}, "voice": {"type": "string", "minLength": 1}, "dialogue": {"type": "string", "minLength": 1}, "music": {"type": "string", "minLength": 1}, "brand": {"type": "string", "minLength": 1}, "artwork": {"type": "string", "minLength": 1}, "settings": {"type": "string", "minLength": 1}, "costume": {"type": "string", "minLength": 1}, "distinctive_props": {"type": "string", "minLength": 1}}},
        "required_media": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["video", "image", "audio", "text"]}},
        "purpose": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "territory": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "target_duration_seconds": {"type": "number", "minimum": 0.001},
        "aspect_ratio": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "concept": {"type": "string", "minLength": 1},
        "cast": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "settings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "palette": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "visual_style": {"type": "string", "minLength": 1},
        "dialogue": {"type": "array", "items": {"type": "string"}},
        "narration": {"type": "array", "items": {"type": "string"}},
        "music": {"type": "string", "minLength": 1},
        "sound_intent": {"type": "string", "minLength": 1},
        "shots": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "prompt"], "properties": {"id": {"type": "string", "pattern": "^S[0-9]{2,}$"}, "prompt": {"type": "string", "minLength": 1}}}},
        "continuity": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "author": {"type": "string", "minLength": 1}
      }
    },
    "similarity_audit": {"type": "object", "additionalProperties": false, "required": ["preserved", "replaced"], "properties": {"preserved": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["timing", "shot_sizes", "camera_moves", "rhythm", "transitions", "audio_beats", "likeness", "voice", "dialogue", "music", "brand", "artwork", "distinctive_props", "effects", "ambience"]}}, "replaced": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["timing", "shot_sizes", "camera_moves", "rhythm", "transitions", "audio_beats", "likeness", "voice", "dialogue", "music", "brand", "artwork", "distinctive_props", "effects", "ambience"]}}}},
    "committed_at": {"type": "string", "minLength": 1}
  }
}
