{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/full-aigc-plugins/dreamina-design-plugin/schemas/audio_plan.schema.json",
  "title": "Dreamina Versioned Audio Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "project_id", "design_fingerprint", "batch_fingerprint", "creative_mode", "audio_policy", "target_duration_seconds", "source_rights", "preserve", "transcript", "rewritten_script", "narration", "music", "effects", "ambience", "subtitles", "provenance", "plan_fingerprint"],
  "allOf": [
    {"if": {"properties": {"creative_mode": {"const": "original_redesign"}}}, "then": {"properties": {"source_rights": {"type": "null"}, "preserve": {"maxItems": 0}}}},
    {"if": {"properties": {"audio_policy": {"const": "full_redesign"}}}, "then": {"properties": {"source_rights": {"type": "null"}, "preserve": {"maxItems": 0}, "rewritten_script": {"minItems": 1}, "narration": {"not": {"type": "null"}}}}},
    {"if": {"properties": {"audio_policy": {"const": "preserve_authorized_audio"}}}, "then": {"properties": {"creative_mode": {"const": "authorized_replication"}, "source_rights": {"type": "object"}, "preserve": {"minItems": 1}}}},
    {"if": {"properties": {"audio_policy": {"const": "silent"}}}, "then": {"properties": {"source_rights": {"type": "null"}, "preserve": {"maxItems": 0}, "narration": {"type": "null"}, "music": {"type": "null"}, "effects": {"maxItems": 0}, "ambience": {"maxItems": 0}}}},
    {"if": {"properties": {"audio_policy": {"const": "subtitles_only"}, "source_rights": {"type": "object"}}}, "then": {"properties": {"creative_mode": {"const": "authorized_replication"}, "preserve": {"minItems": 1}}}},
    {"if": {"properties": {"audio_policy": {"const": "subtitles_only"}, "source_rights": {"type": "null"}}}, "then": {"properties": {"preserve": {"maxItems": 0}, "narration": {"type": "null"}, "music": {"type": "null"}, "effects": {"maxItems": 0}, "ambience": {"maxItems": 0}}}}
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "version": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "project_id": {"type": "string", "pattern": "^vp_[a-f0-9]{24}$"},
    "design_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "batch_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "creative_mode": {"type": "string", "enum": ["authorized_replication", "original_redesign"]},
    "audio_policy": {"type": "string", "enum": ["full_redesign", "preserve_authorized_audio", "subtitles_only", "silent"]},
    "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "source_rights": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["receipt_id", "receipt_fingerprint", "allowed_reuse", "artifact_bindings"], "properties": {"receipt_id": {"type": "string", "pattern": "^rr_[a-f0-9]{24}$"}, "receipt_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "allowed_reuse": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["voice", "dialogue", "music", "effects", "ambience"]}}, "artifact_bindings": {"type": "object", "additionalProperties": false, "properties": {"voice": {"$ref": "#/$defs/sourceBinding"}, "dialogue": {"$ref": "#/$defs/sourceBinding"}, "music": {"$ref": "#/$defs/sourceBinding"}, "effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceBinding"}}, "ambience": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceBinding"}}}}}}]},
    "preserve": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["voice", "dialogue", "music", "effects", "ambience"]}},
    "transcript": {"anyOf": [{"type": "null"}, {"$ref": "transcript_receipt.schema.json"}]},
    "rewritten_script": {"type": "array", "items": {"$ref": "#/$defs/timedText"}},
    "narration": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/newNarrationArtifact"}, {"$ref": "#/$defs/existingVoiceArtifact"}, {"$ref": "#/$defs/existingDialogueArtifact"}, {"$ref": "#/$defs/existingVoiceDialogueArtifact"}]},
    "music": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/musicArtifact"}]},
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effectArtifact"}},
    "ambience": {"type": "array", "items": {"$ref": "#/$defs/ambienceArtifact"}},
    "subtitles": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/subtitleSrtArtifact"}, {"$ref": "#/$defs/subtitleAssArtifact"}]}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["remote_services_used", "source_voice_cloned"], "properties": {"remote_services_used": {"type": "boolean", "const": false}, "source_voice_cloned": {"type": "boolean", "const": false}}},
    "plan_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "sourceBinding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "timedText": {"type": "object", "additionalProperties": false, "required": ["start", "end", "text"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "text": {"type": "string", "minLength": 1, "maxLength": 500}, "language": {"type": "string"}, "confidence": {"type": "number", "minimum": -1, "maximum": 1}, "requires_review": {"type": "boolean"}, "provider": {"type": "string"}, "model": {"type": "string"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "completeTranscript": {"type": "object", "additionalProperties": false, "required": ["status", "provider", "model", "artifact_sha256", "segments"], "properties": {"status": {"type": "string", "const": "complete"}, "provider": {"type": "string", "const": "whisper"}, "model": {"type": "string", "minLength": 1}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "segments": {"type": "array", "items": {"$ref": "#/$defs/timedText"}}}},
    "unavailableTranscript": {"type": "object", "additionalProperties": false, "required": ["status", "reason", "detail", "segments"], "properties": {"status": {"type": "string", "enum": ["blocked", "degraded"]}, "reason": {"type": "string", "enum": ["asr_provider_unavailable", "asr_output_invalid"]}, "detail": {"type": "string", "minLength": 1, "maxLength": 128}, "segments": {"type": "array", "maxItems": 0}}},
    "newNarrationProvenance": {"type":"object","additionalProperties":false,"required":["kind","rights_declared","approved_root","source","voice","model","source_voice_cloned"],"properties":{"kind":{"const":"new_narration"},"rights_declared":{"type":"array","minItems":1,"uniqueItems":true,"items":{"const":"voice"}},"approved_root":{"type":"null"},"source":{"const":"rewritten_script"},"voice":{"type":"string","minLength":1},"model":{"const":"macos-say"},"source_voice_cloned":{"const":false}}},
    "existingProvenance": {"type":"object","additionalProperties":false,"required":["kind","rights_declared","approved_root","source","voice","model","source_voice_cloned"],"properties":{"kind":{"const":"user_supplied"},"rights_declared":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["voice","dialogue","music","effects","ambience"]}},"approved_root":{"type":"string","pattern":"^/"},"source":{"const":"user_supplied"},"voice":{"type":"null"},"model":{"type":"null"},"source_voice_cloned":{"const":false}}},
    "subtitleProvenance": {"type":"object","additionalProperties":false,"required":["kind","rights_declared","approved_root","source","voice","model","source_voice_cloned"],"properties":{"kind":{"const":"generated_subtitle"},"rights_declared":{"type":"array","const":["subtitles"],"minItems":1,"maxItems":1,"uniqueItems":true,"items":{"const":"subtitles"}},"approved_root":{"type":"null"},"source":{"enum":["rewritten_script","narration_timing"]},"voice":{"type":"null"},"model":{"type":"null"},"source_voice_cloned":{"const":false}}},
    "artifactCore": {"type":"object","additionalProperties":false,"required":["artifact_role","provider","path","sha256","size_bytes","mime_type","provenance","attestation_version","attestation_key_id","attestation"],"properties":{"artifact_role":{"enum":["new_narration","existing_voice","existing_dialogue","existing_voice_dialogue","music","effect","ambience","subtitle_srt","subtitle_ass"]},"provider":{},"path":{"type":"string","pattern":"^/"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"size_bytes":{"type":"integer","minimum":1},"mime_type":{},"provenance":{},"attestation_version":{"const":1},"attestation_key_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"attestation":{"type":"string","pattern":"^[a-f0-9]{64}$"},"at_seconds":{"type":"number","minimum":0},"duration_seconds":{"type":"number","exclusiveMinimum":0}}},
    "newNarrationArtifact": {"allOf":[{"$ref":"#/$defs/artifactCore"},{"properties":{"artifact_role":{"const":"new_narration"},"provider":{"const":"macos-say"},"mime_type":{"const":"audio/aiff"},"provenance":{"allOf":[{"$ref":"#/$defs/newNarrationProvenance"},{"properties":{"rights_declared":{"const":["voice"]}}}]}}}]},
    "existingVoiceArtifact": {"allOf":[{"$ref":"#/$defs/artifactCore"},{"properties":{"artifact_role":{"const":"existing_voice"},"provider":{"const":"existing-audio"},"mime_type":{"const":"audio/wav"},"provenance":{"allOf":[{"$ref":"#/$defs/existingProvenance"},{"properties":{"rights_declared":{"const":["voice"]}}}]}}}]},
    "existingDialogueArtifact": {"allOf":[{"$ref":"#/$defs/artifactCore"},{"properties":{"artifact_role":{"const":"existing_dialogue"},"provider":{"const":"existing-audio"},"mime_type":{"const":"audio/wav"},"provenance":{"allOf":[{"$ref":"#/$defs/existingProvenance"},{"properties":{"rights_declared":{"const":["dialogue"]}}}]}}}]},
    "existingVoiceDialogueArtifact": {"allOf":[{"$ref":"#/$defs/artifactCore"},{"properties":{"artifact_role":{"const":"existing_voice_dialogue"},"provider":{"const":"existing-audio"},"mime_type":{"const":"audio/wav"},"provenance":{"allOf":[{"$ref":"#/$defs/existingProvenance"},{"properties":{"rights_declared":{"const":["dialogue","voice"]}}}]}}}]},
    "effectArtifact": {"allOf":[{"$ref":"#/$defs/artifactCore"},{"required":["at_seconds","duration_seconds"],"properties":{"artifact_role":{"const":"effect"},"provider":{"const":"existing-audio"},"mime_type":{"const":"audio/wav"},"provenance":{"allOf":[{"$ref":"#/$defs/existingProvenance"},{"properties":{"rights_declared":{"const":["effects"]}}}]}}}]},
    "ambienceArtifact": {"allOf":[{"$ref":"#/$defs/artifactCore"},{"required":["at_seconds","duration_seconds"],"properties":{"artifact_role":{"const":"ambience"},"provider":{"const":"existing-audio"},"mime_type":{"const":"audio/wav"},"provenance":{"allOf":[{"$ref":"#/$defs/existingProvenance"},{"properties":{"rights_declared":{"const":["ambience"]}}}]}}}]},
    "subtitleSrtArtifact": {"allOf":[{"$ref":"#/$defs/artifactCore"},{"properties":{"artifact_role":{"const":"subtitle_srt"},"provider":{"const":"subtitle-service"},"mime_type":{"const":"application/x-subrip"},"provenance":{"$ref":"#/$defs/subtitleProvenance"}}}]},
    "subtitleAssArtifact": {"allOf":[{"$ref":"#/$defs/artifactCore"},{"properties":{"artifact_role":{"const":"subtitle_ass"},"provider":{"const":"subtitle-service"},"mime_type":{"const":"text/x-ssa"},"provenance":{"$ref":"#/$defs/subtitleProvenance"}}}]},
    "musicArtifact": {"type":"object","additionalProperties":false,"required":["artifact_role","provider","path","sha256","size_bytes","mime_type","provenance","attestation_version","attestation_key_id","attestation","intent"],"properties":{"artifact_role":{"const":"music"},"provider":{"const":"existing-audio"},"path":{"type":"string","pattern":"^/"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"size_bytes":{"type":"integer","minimum":1},"mime_type":{"const":"audio/wav"},"provenance":{"allOf":[{"$ref":"#/$defs/existingProvenance"},{"properties":{"rights_declared":{"const":["music"]}}}]},"attestation_version":{"const":1},"attestation_key_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"attestation":{"type":"string","pattern":"^[a-f0-9]{64}$"},"intent":{"type":"object","additionalProperties":false,"required":["loop","trim_to_seconds","use_full_track"],"oneOf":[{"properties":{"loop":{"const":false},"trim_to_seconds":{"type":"null"},"use_full_track":{"const":true}}},{"properties":{"trim_to_seconds":{"type":"number","exclusiveMinimum":0},"use_full_track":{"const":false}}}],"properties":{"loop":{"type":"boolean"},"trim_to_seconds":{"type":["number","null"],"exclusiveMinimum":0},"use_full_track":{"type":"boolean"}}}}}
  }
}
