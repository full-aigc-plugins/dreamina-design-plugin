{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/partme-ai/codex-dreamina-design-plugin/schemas/shot_evaluation.schema.json",
  "title": "Canonical Generated Shot Evaluation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "binding", "artifact_evidence", "measured_gates", "semantic_gates", "failed_gates", "decision", "evaluator", "evaluation_fingerprint"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "evaluation_id": {"type": "string", "pattern": "^eval_[A-Za-z0-9_-]{1,120}$"},
    "binding": {"$ref": "#/$defs/binding"},
    "artifact_evidence": {"$ref": "#/$defs/artifact_evidence"},
    "measured_gates": {"$ref": "#/$defs/measured_gates"},
    "semantic_gates": {"$ref": "#/$defs/semantic_gates"},
    "failed_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["artifact_integrity", "dimensions", "codec", "duration", "aspect_ratio", "frame_readability", "start_anchor", "end_anchor", "intent", "composition", "identity_continuity", "camera_behavior", "rhythm_function", "temporal_defects", "source_copying", "subtitle_safe_area"]}},
    "decision": {"$ref": "#/$defs/decision"},
    "evaluator": {"$ref": "#/$defs/evaluator"},
    "evaluation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "binding": {"type": "object", "additionalProperties": false, "required": ["project_id", "batch_version", "shot_id", "attempt", "artifact_sha256", "design_version", "design_fingerprint", "quote_fingerprint", "allowance_id"], "properties": {"project_id": {"type": "string", "pattern": "^vp_[a-f0-9]{24}$"}, "batch_version": {"type": "string", "pattern": "^v[0-9]{3,}$"}, "shot_id": {"type": "string", "pattern": "^S[0-9]{2,}$"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 3}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "design_version": {"type": "string", "pattern": "^v[0-9]{3,}$"}, "design_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "quote_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "allowance_id": {"type": "string", "pattern": "^ba_[a-f0-9]{32}$"}}},
    "artifact_evidence": {"type": "object", "additionalProperties": false, "required": ["path", "mime_type", "size_bytes", "sha256", "provenance", "probe", "frames"], "properties": {"path": {"type": "string", "pattern": "^/"}, "mime_type": {"type": "string", "enum": ["video/mp4"]}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "provenance": {"type": "string", "const": "externally-queried"}, "probe": {"type": "object", "additionalProperties": false, "required": ["width", "height", "codec", "duration_seconds"], "properties": {"width": {"type": ["integer", "null"], "minimum": 1}, "height": {"type": ["integer", "null"], "minimum": 1}, "codec": {"type": ["string", "null"]}, "duration_seconds": {"type": ["number", "null"], "minimum": 0}}}, "frames": {"type": "object", "additionalProperties": false, "required": ["readable", "start_anchor", "end_anchor"], "properties": {"readable": {"type": ["boolean", "null"]}, "start_anchor": {"type": ["boolean", "null"]}, "end_anchor": {"type": ["boolean", "null"]}}}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"type": "string", "enum": ["passed", "failed", "unavailable"]}, "evidence": {"type": "string", "minLength": 1}}},
    "measured_gates": {"type": "object", "additionalProperties": false, "required": ["artifact_integrity", "dimensions", "codec", "duration", "aspect_ratio", "frame_readability", "start_anchor", "end_anchor"], "properties": {"artifact_integrity": {"$ref": "#/$defs/gate"}, "dimensions": {"$ref": "#/$defs/gate"}, "codec": {"$ref": "#/$defs/gate"}, "duration": {"$ref": "#/$defs/gate"}, "aspect_ratio": {"$ref": "#/$defs/gate"}, "frame_readability": {"$ref": "#/$defs/gate"}, "start_anchor": {"$ref": "#/$defs/gate"}, "end_anchor": {"$ref": "#/$defs/gate"}}},
    "semantic_gates": {"type": "object", "additionalProperties": false, "required": ["intent", "composition", "identity_continuity", "camera_behavior", "rhythm_function", "temporal_defects", "source_copying", "subtitle_safe_area"], "properties": {"intent": {"$ref": "#/$defs/gate"}, "composition": {"$ref": "#/$defs/gate"}, "identity_continuity": {"$ref": "#/$defs/gate"}, "camera_behavior": {"$ref": "#/$defs/gate"}, "rhythm_function": {"$ref": "#/$defs/gate"}, "temporal_defects": {"$ref": "#/$defs/gate"}, "source_copying": {"$ref": "#/$defs/gate"}, "subtitle_safe_area": {"$ref": "#/$defs/gate"}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"type": "string", "enum": ["accepted", "retry", "rejected", "manual_review"]}, "repair_directive": {"type": "string", "enum": ["identity_consistency", "camera_match", "remove_text", "temporal_stability"]}, "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "allOf": [{"if": {"properties": {"action": {"const": "retry"}}}, "then": {"required": ["repair_directive", "request_fingerprint"]}, "else": {"not": {"anyOf": [{"required": ["repair_directive"]}, {"required": ["request_fingerprint"]}]}}}]},
    "evaluator": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "evaluated_at"], "properties": {"provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "evaluated_at": {"type": "string", "minLength": 1}}}
  }
}
