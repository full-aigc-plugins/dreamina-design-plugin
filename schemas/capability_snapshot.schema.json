{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/full-aigc-plugins/dreamina-design-plugin/schemas/capability_snapshot.schema.json",
  "title": "Dreamina Capability Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["cli_version", "captured_at", "modes"],
  "properties": {
    "cli_version": {
      "type": "string",
      "description": "dreamina CLI version string as reported by `dreamina --version`.",
      "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+(?:[+-][A-Za-z0-9.-]+)?|[0-9a-fA-F]{7,40}(?:-dirty)?)$"
    },
    "cli_commit": {
      "type": "string",
      "description": "Optional CLI build commit SHA, when reported."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp when the snapshot was taken."
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["text2image", "image2image", "text2video", "image2video", "frames2video", "multiframe2video", "multimodal2video"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "modes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "modes": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "resolutions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "ratios": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "max_count": {"type": "integer", "minimum": 1},
          "max_references": {"type": "integer", "minimum": 1},
          "duration_min_seconds": {"type": "integer", "minimum": 1},
          "duration_max_seconds": {"type": "integer", "minimum": 1},
          "ratio_forbidden_modes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "web_prerequisite_required": {"type": "boolean"},
          "audio_reference_max_seconds": {"type": "integer", "minimum": 1}
        }
      }
    },
    "resolutions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "video": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "ratios": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "durations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_seconds": {"type": "integer", "minimum": 1},
        "max_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "mode_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "multiframe2video": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_references", "max_references", "request_duration_min_seconds", "request_duration_max_seconds", "transition_duration_min_seconds", "transition_duration_max_seconds"],
          "properties": {
            "min_references": {"type": "integer", "minimum": 1},
            "max_references": {"type": "integer", "minimum": 1},
            "request_duration_min_seconds": {"type": "integer", "minimum": 1},
            "request_duration_max_seconds": {"type": "integer", "minimum": 1},
            "transition_duration_min_seconds": {"type": "integer", "minimum": 1},
            "transition_duration_max_seconds": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credit_ceiling_per_attempt", "source", "captured_at"],
      "properties": {
        "credit_ceiling_per_attempt": {"type": "integer", "minimum": 1},
        "source": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
