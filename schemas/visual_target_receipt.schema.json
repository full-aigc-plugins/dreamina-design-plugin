{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_target_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "media_kind", "source_path", "sha256", "size_bytes", "mime_type", "width", "height", "approved_roots", "approved_roots_digest", "source", "created_at", "receipt_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target_id": {"type": "string", "pattern": "^vt_[a-f0-9]{24}$"},
    "media_kind": {"enum": ["image", "video", "dcc_preview"]},
    "source_path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "mime_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "approved_roots": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "approved_roots_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["user_supplied", "generated", "existing_artifact", "dcc_capture"]}, "provider": {"type": "string", "maxLength": 100}, "submit_id": {"type": "string", "maxLength": 128}}},
    "created_at": {"type": "string", "minLength": 20},
    "receipt_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
