{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/partme-ai/partme-dreamina-design/schemas/video_batch_allowance.schema.json",
  "title": "Durable Dreamina Video Batch Allowance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "allowance_id", "state", "project_id", "quote_version", "quote_fingerprint", "quote_identity", "source_sha256", "analysis_version", "design_version", "design_fingerprint", "creative_mode", "audio_policy", "destination", "output_profile", "capability_snapshot_fingerprint", "cost_basis", "item_count", "task_count", "reserved_retry_count", "total_credit_ceiling", "consumed_credits", "requests", "reservations", "activated_at", "history", "seal_key_id", "seal"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "allowance_id": {"type": "string", "pattern": "^ba_[a-f0-9]{32}$"},
    "state": {"type": "string", "enum": ["active", "exhausted"]},
    "project_id": {"type": "string", "pattern": "^vp_[a-f0-9]{24}$"},
    "quote_version": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "quote_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "quote_identity": {"type": "object", "additionalProperties": false, "required": ["project_id", "family", "version", "path", "fingerprint"], "properties": {"project_id": {"type": "string", "pattern": "^vp_[a-f0-9]{24}$"}, "family": {"type": "string", "const": "video_batch_quote"}, "version": {"type": "string", "pattern": "^v[0-9]{3,}$"}, "path": {"type": "string", "pattern": "^vp_[a-f0-9]{24}/video_batch_quote/v[0-9]{3,}\\.json$"}, "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis_version": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "design_version": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "design_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rights_receipt_id": {"type": "string", "pattern": "^rr_[a-f0-9]{24}$"},
    "rights_receipt_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "creative_mode": {"type": "string", "enum": ["authorized_replication", "original_redesign"]},
    "audio_policy": {"type": "string", "enum": ["full_redesign", "preserve_authorized_audio", "subtitles_only", "silent"]},
    "destination": {"type": "string", "minLength": 1},
    "output_profile": {"type": "object", "additionalProperties": false, "required": ["container", "codec"], "properties": {"container": {"type": "string", "const": "mp4"}, "codec": {"type": "string", "const": "h264"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "fps": {"type": "number", "minimum": 1}}},
    "capability_snapshot_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cost_basis": {"type": "object", "additionalProperties": false, "required": ["kind", "credit_ceiling", "currency", "source", "recorded_at"], "properties": {"kind": {"type": "string", "enum": ["operator_ceiling", "live_snapshot"]}, "credit_ceiling": {"type": "integer", "minimum": 1}, "currency": {"type": "string", "const": "credits"}, "source": {"type": "string", "minLength": 1}, "recorded_at": {"type": "string", "minLength": 1}}},
    "item_count": {"type": "integer", "minimum": 1},
    "task_count": {"type": "integer", "minimum": 1},
    "reserved_retry_count": {"type": "integer", "minimum": 0},
    "total_credit_ceiling": {"type": "integer", "minimum": 1},
    "consumed_credits": {"type": "integer", "minimum": 0},
    "requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request"}},
    "reservations": {"type": "array", "items": {"$ref": "#/$defs/reservation"}},
    "activated_at": {"type": "string", "minLength": 1},
    "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/history"}},
    "seal_key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "seal": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"creative_mode": {"const": "authorized_replication"}}}, "then": {"required": ["rights_receipt_id", "rights_receipt_fingerprint"]}, "else": {"not": {"anyOf": [{"required": ["rights_receipt_id"]}, {"required": ["rights_receipt_fingerprint"]}]}}}
  ],
  "$defs": {
    "request": {"type": "object", "additionalProperties": false, "required": ["shot_id", "attempt", "mode", "model", "video_resolution", "duration_seconds", "request_fingerprint", "credit_ceiling"], "properties": {"shot_id": {"type": "string", "pattern": "^S[0-9]{2,}$"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 3}, "mode": {"type": "string", "enum": ["text2video", "image2video", "frames2video", "multiframe2video", "multimodal2video"]}, "model": {"type": ["string", "null"]}, "video_resolution": {"type": "string", "minLength": 1}, "duration_seconds": {"type": "integer", "minimum": 1}, "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "credit_ceiling": {"type": "integer", "minimum": 1}}},
    "reservation": {"type": "object", "additionalProperties": false, "required": ["reservation_id", "allowance_id", "shot_id", "attempt", "request_fingerprint", "credit_ceiling", "state", "reserved_at", "history"], "properties": {"reservation_id": {"type": "string", "pattern": "^br_[a-f0-9]{32}$"}, "allowance_id": {"type": "string", "pattern": "^ba_[a-f0-9]{32}$"}, "shot_id": {"type": "string", "pattern": "^S[0-9]{2,}$"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 3}, "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "credit_ceiling": {"type": "integer", "minimum": 1}, "state": {"type": "string", "enum": ["reserved", "committed", "ambiguous"]}, "reserved_at": {"type": "string", "minLength": 1}, "submit_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}, "error_code": {"type": "string", "pattern": "^[A-Z0-9_-]{1,128}$"}, "required_action": {"type": "string", "enum": ["query", "manual_review"]}, "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/history"}}}, "allOf": [{"if": {"properties": {"state": {"const": "ambiguous"}}}, "then": {"required": ["error_code", "required_action"]}}]},
    "history": {"type": "object", "additionalProperties": false, "required": ["state", "at"], "properties": {"state": {"type": "string", "minLength": 1}, "at": {"type": "string", "minLength": 1}, "reservation_id": {"type": "string", "pattern": "^br_[a-f0-9]{32}$"}, "submit_id": {"type": "string", "minLength": 1}, "error_code": {"type": "string", "minLength": 1}, "required_action": {"type": "string", "enum": ["query", "manual_review"]}}}
  }
}
