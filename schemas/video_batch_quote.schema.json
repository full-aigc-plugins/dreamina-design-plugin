{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/partme-ai/codex-dreamina-design-plugin/schemas/video_batch_quote.schema.json",
  "title": "Immutable Dreamina Video Batch Quote",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quote_version", "project_id", "design_version", "design_fingerprint", "rights_receipt_id", "source_sha256", "analysis_version", "machine_fingerprint", "creative_mode", "audio_policy", "output_destination", "output_profile", "capability_snapshot_fingerprint", "cost_basis", "items", "total_credit_ceiling", "quoted_at", "quote_fingerprint"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "quote_version": {"type": "string", "const": "v001"},
    "project_id": {"type": "string", "pattern": "^vp_[a-f0-9]{24}$"},
    "design_version": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "design_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rights_receipt_id": {"type": ["string", "null"], "pattern": "^rr_[a-f0-9]{24}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis_version": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "machine_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "creative_mode": {"type": "string", "enum": ["authorized_replication", "original_redesign"]},
    "audio_policy": {"type": "string", "enum": ["full_redesign", "preserve_authorized_audio", "subtitles_only", "silent"]},
    "output_destination": {"type": "string", "minLength": 1},
    "output_profile": {"type": "object", "additionalProperties": false, "required": ["container", "codec"], "properties": {"container": {"type": "string", "enum": ["mp4"]}, "codec": {"type": "string", "enum": ["h264", "h265"]}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "fps": {"type": "number", "minimum": 1}}},
    "capability_snapshot_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cost_basis": {"type": "object", "additionalProperties": false, "required": ["kind", "credit_ceiling", "currency", "source", "recorded_at"], "properties": {"kind": {"type": "string", "enum": ["operator_ceiling", "live_snapshot"]}, "credit_ceiling": {"type": "integer", "minimum": 1}, "currency": {"type": "string", "const": "credits"}, "source": {"type": "string", "minLength": 1}, "recorded_at": {"type": "string", "minLength": 1}}},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "total_credit_ceiling": {"type": "integer", "minimum": 1},
    "quoted_at": {"type": "string", "minLength": 1},
    "quote_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "item": {"type": "object", "additionalProperties": false, "required": ["shot_id", "mode", "credit_ceiling", "request_fingerprints", "attempts"], "properties": {"shot_id": {"type": "string", "pattern": "^S[0-9]{2,}$"}, "mode": {"type": "string", "enum": ["text2video", "image2video", "frames2video", "multiframe2video", "multimodal2video"]}, "credit_ceiling": {"type": "integer", "minimum": 1}, "request_fingerprints": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "attempts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}}}},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["attempt_number", "repair_directive", "request", "request_fingerprint", "credit_ceiling"], "properties": {"attempt_number": {"type": "integer", "minimum": 1, "maximum": 3}, "repair_directive": {"type": ["string", "null"], "enum": [null, "identity_consistency", "camera_match", "remove_text", "temporal_stability"]}, "request": {"$ref": "#/$defs/request"}, "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "credit_ceiling": {"type": "integer", "minimum": 1}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["mode", "prompt", "video_resolution", "duration_seconds"], "properties": {"mode": {"type": "string", "enum": ["text2video", "image2video", "frames2video", "multiframe2video", "multimodal2video"]}, "prompt": {"type": "string", "minLength": 1, "maxLength": 4000}, "model": {"type": "string", "minLength": 1}, "video_resolution": {"type": "string", "minLength": 1}, "ratio": {"type": "string", "minLength": 1}, "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 30}, "references": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/reference"}}, "transitions": {"type": "array", "maxItems": 19, "items": {"$ref": "#/$defs/transition"}}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "role"], "properties": {"path": {"type": "string", "minLength": 1}, "role": {"type": "string", "enum": ["style", "subject", "frame", "audio", "reference"]}, "mime_type": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "duration_seconds": {"type": "integer", "minimum": 1}}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["prompt", "duration_seconds"], "properties": {"prompt": {"type": "string", "minLength": 1}, "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 8}}}
  }
}
