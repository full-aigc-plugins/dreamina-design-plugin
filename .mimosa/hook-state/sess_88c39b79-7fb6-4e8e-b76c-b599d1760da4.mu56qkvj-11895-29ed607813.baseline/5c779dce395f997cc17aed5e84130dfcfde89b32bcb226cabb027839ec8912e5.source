"""Batched verifier against real pinned upstream composition, without Chrome."""
import hashlib
import json
import os
import shutil
import struct
import subprocess
import time
import unittest
import zlib
from pathlib import Path
from scripts import reelbench_workspace as ws
from scripts.reelbench_adapter import ReelBenchAdapterError
from tests.reelbench_sync_fixture import SyncFixture

def panel_png(width,height,*,lit=False,rows=False):
    def chunk(kind,data): return struct.pack('>I',len(data))+kind+data+struct.pack('>I',zlib.crc32(kind+data))
    raw=bytearray()
    for y in range(height):
        value=(170 if lit else 25)+(y//32%12)*4 if rows else 30
        raw.extend(b'\0'+bytes([value,value,value])*width)
    return b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',struct.pack('>IIBBBBB',width,height,8,2,0,0,0))+chunk(b'IDAT',zlib.compress(raw))+chunk(b'IEND',b'')

class BatchSamplingTests(unittest.TestCase):
    def test_120_short_shots_use_five_bounded_decode_processes(self):
        f=SyncFixture(self)
        directory=f.root/'batch-work'; directory.mkdir(mode=0o700)
        fd=os.open(directory,ws.DIRECTORY); self.addCleanup(os.close,fd)
        ws.mkdir(fd,'source'); ws.mkdir(fd,'output/panels'); ws.mkdir(fd,'inputs')
        count=120; duration=36
        subprocess.run([shutil.which('ffmpeg'),'-v','error','-f','lavfi','-i',f'color=c=red:s=640x360:r=30:d={duration}',
            '-c:v','libx264','-pix_fmt','yuv420p',str(directory/'source/original.mp4')],check=True,capture_output=True)
        shots={'meta':{'durationSeconds':duration},'shots':[{'id':f'S{i+1:02d}','start':round(i*.3,2),'end':round((i+1)*.3,2)} for i in range(count)]}
        ws.write(fd,'inputs/shots.json',json.dumps(shots).encode())
        layout={'panel':{'width':640,'height':288},'view':{'x':16,'y':40,'width':600,'height':192},
            'content':count*32,'tallHeight':count*32,'rows':[{'id':s['id'],'top':i*32,'height':32} for i,s in enumerate(shots['shots'])]}
        ws.write(fd,'output/panels/layout.json',json.dumps(layout).encode())
        for name,lit,rows,height in (('static.png',False,False,288),('list-dim.png',False,True,count*32),('list-lit.png',True,True,count*32)):
            ws.write(fd,'output/panels/'+name,panel_png(640,height,lit=lit,rows=rows))
        consumed=[{'workspace_path':path,**f.service._digest(fd,path,2*1024**3)} for path in ('source/original.mp4','inputs/shots.json')]
        with f.adapter.execution_workspace(fd,consumed,workflow='sync'):
            f.adapter.set_sync_duration(duration)
            plan=json.loads(f.adapter.sync_plan(shots=Path(f'/dev/fd/{fd}/inputs/shots.json'),source=Path(f'/dev/fd/{fd}/source/original.mp4')).stdout)
            f.adapter._run('compose',['inputs/shots.json','--video','source/original.mp4','--panels','output/panels','-o','output/review.mp4'],workflow='sync')
            commands=[]; started=time.monotonic()
            alignment=f.service._sample_alignment(fd,'source/original.mp4',plan,layout,shots,commands)
            self.assertEqual(len(commands),5)
            self.assertEqual(len(alignment),120)
            self.assertLess(time.monotonic()-started,120)
            self.assertTrue(all(s['source_error']<=18 and s['highlight_error']<=22 and s['panel_transition']['passed'] for s in alignment))
            f.adapter._deadline.set(time.monotonic()-1)
            with self.assertRaisesRegex(ReelBenchAdapterError,'ACTION_DEADLINE_EXCEEDED'): f.adapter._remaining(1800)
        self.assertFalse((directory/'output/samples').exists())
